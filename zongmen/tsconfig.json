{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "assets/**/*.ts",
    "assets/**/*.d.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
