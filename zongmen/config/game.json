{
  "questions": 30,
  "dawn_warning_at": 5,
  "input_max_chars": 60,
  "history_turns": 8,
  "suspects_per_case": 5,
  "stress": {
    "contradiction": 30,
    "irrelevant_evidence": 5,
    "tone": {
      "friendly": -5,
      "neutral": 0,
      "pressing": 10,
      "threatening": 10,
      "off_topic": 0,
      "manipulation": 0
    },
    "confess_at": 60,
    "after_confess": 20,
    "culprit_panic_at": 70,
    "culprit_slip_at": 85,
    "refuse_at": 100
  },
  "rating": {
    "s_min_remaining": 10
  },
  "reply": {
    "soft_max_chars": 80,
    "hard_max_chars": 120
  },
  "budget": {
    "dialogue_calls": 30,
    "epilogue_calls": 1,
    "max_calls_per_case": 40,
    "max_input_tokens": 2500,
    "max_card_tokens": 1500,
    "max_output_tokens": 300
  },
  "generator": {
    "version": 1,
    "max_attempts": 50,
    "fact_min": 10,
    "fact_max": 20,
    "suspects_min": 2,
    "suspects_max": 3
  },
  "model": {
    "provider": "template",
    "providers": {
      "template": {},
      "openai_compatible": {
        "base_url": "https://api.deepseek.com/v1",
        "model": "deepseek-chat",
        "api_key_env": "ZONGMEN_API_KEY",
        "note": "只在本机开发和评测时用；密钥从环境变量读取，绝不写进仓库或发布包。浏览器里只允许指向自建代理，不带密钥。"
      },
      "platform": {
        "note": "造化工坊平台模型服务。第 0 阶段未找到公开接口，待用户确认后接入。"
      }
    },
    "dialogue": { "temperature": 0.8, "max_tokens": 300 },
    "epilogue": { "temperature": 0.9, "max_tokens": 400 },
    "json_mode": true,
    "timeout_ms": 15000,
    "retries": 1
  },
  "dev": {
    "show_call_stats": true
  }
}
