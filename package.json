{
  "name": "hanyi",
  "version": "0.1.0",
  "private": true,
  "description": "寒驿：一款以角色为核心的生存经营游戏",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "sim": "node scripts/build.mjs --sim && node dist/sim.cjs",
    "art": "node scripts/art.mjs",
    "sim:qm": "esbuild scripts/sim-qingming.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=dist/sim-qingming.cjs && node dist/sim-qingming.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  }
}
